VITE_APP_TITLE=CongoAddressMapper
VITE_APP_LOGO=/images/logo.jpg
OPENAI_API_KEY=your-openai-api-key
DATABASE_URL=postgresql://example-user:example-password@localhost:5432/main
# Infrastructure (server-only)
PORT=3000

# Image generation provider
# Choose which AI image provider to use: 'openai' or 'recraft'
IMAGE_PROVIDER=openai

# OpenAI image generation (if IMAGE_PROVIDER=openai)
# Model name for image generation
OPENAI_IMAGE_MODEL=gpt-image-1

# Recraft image generation (if IMAGE_PROVIDER=recraft)
# Base URL for the Recraft API, e.g. https://api.recraft.ai
RECRAFT_API_URL=
# API key for Recraft
RECRAFT_API_KEY=

# Cloudinary (used to store generated images)
# Cloud name from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
# API key from your Cloudinary dashboard
CLOUDINARY_API_KEY=
# API secret from your Cloudinary dashboard
CLOUDINARY_API_SECRET=
# Optional: folder name to organize uploaded training images
CLOUDINARY_FOLDER=training
